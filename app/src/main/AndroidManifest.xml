<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talk to the Syntra backend (REST + WebSocket) and Supabase. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice rooms + calls: LiveKit needs the mic plus audio/network state. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Video calls need the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Read the device gallery to show it in the "Tambah status" grid. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Read the phone's own music library for the "Lagu di perangkat" page. Audio has
         its own permission on 33+; below that READ_EXTERNAL_STORAGE (declared under)
         covers it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 14+ lets people grant access to SELECTED photos rather than all of
         them. Declaring this is what makes that choice reachable: without it the
         system offers only all-or-nothing, and someone who is not willing to hand over
         their entire gallery has to deny outright — so the "Tambah status" grid comes
         up empty and looks broken rather than restricted. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Save a reel to the gallery on pre-scoped-storage devices (API ≤ 28). On 29+
         MediaStore handles this with no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Chat notifications without Firebase/FCM: a foreground service keeps the
         WebSocket alive so new messages arrive while the app is in the background,
         and shows a local notification. All over the app's own backend, no Google. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets an incoming call take over a locked screen instead of arriving as a
         silent banner. Android 14+ grants this by default only to apps whose primary
         purpose is calling; where it is refused the notification still shows as a
         heads-up with both buttons, so a call is never missed either way. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Keep a call (audio/video) alive while the phone sleeps: a mic/camera-typed
         foreground service is the only way to hold the mic/camera in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".SyntraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Syntra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Syntra"
            android:supportsPictureInPicture="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the realtime chat socket connected in the background so new-message
             notifications arrive without Firebase. dataSync type = it maintains a
             network connection to sync data. -->
        <service
            android:name=".net.ChatConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Holds a call open while the phone sleeps (mic always, camera for video). -->
        <service
            android:name=".net.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
    </application>

</manifest>
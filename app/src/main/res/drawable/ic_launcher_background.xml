<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Full-bleed brand gradient; the adaptive mask rounds the corners. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="8"
                android:endX="100"
                android:endY="100">
                <item android:color="#FF1B49C9" android:offset="0.0" />
                <item android:color="#FF2E6BF0" android:offset="0.5" />
                <item android:color="#FF4D9BFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- AURORA. Three offset radial washes instead of one flat highlight. A single
         corner glow reads as a bevel; overlapping sheets of light read as depth, and
         they are what stop the tile looking like a solid swatch with a letter on it. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="26" android:centerY="22" android:gradientRadius="74">
                <item android:color="#8873C6FF" android:offset="0.0" />
                <item android:color="#0073C6FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="88" android:centerY="70" android:gradientRadius="66">
                <item android:color="#7716C0FF" android:offset="0.0" />
                <item android:color="#0016C0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="58" android:centerY="102" android:gradientRadius="58">
                <item android:color="#66103A9E" android:offset="0.0" />
                <item android:color="#00103A9E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Android blocks cleartext HTTP by default since API 28. The Syntra backend runs
    over plain http:// on the LAN during development, so those hosts are allowed
    explicitly. Everything else still requires TLS.

    Add your own host here if the server moves; do not switch to a blanket
    cleartextTrafficPermitted="true" on the base config for production builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Dev server on the LAN -->
        <domain includeSubdomains="false">192.168.1.6</domain>
        <domain includeSubdomains="false">192.168.1.174</domain>
        <!-- Emulator's route to the host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
